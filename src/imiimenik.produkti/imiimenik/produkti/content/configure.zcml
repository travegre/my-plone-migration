<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:five="http://namespaces.zope.org/five"
    i18n_domain="imiimenik.produkti">

  <!-- configure your content components here -->
  
  <!-- -*- extra stuff goes here -*- -->
  <class class=".uvoz.uvoz">
    <require
        permission="zope2.View"
        interface="..interfaces.Iuvoz"
        />
  </class>
  <class class=".produkti.produkti">
    <require
        permission="zope2.View"
        interface="..interfaces.Iprodukti"
        />
  </class>

</configure>
